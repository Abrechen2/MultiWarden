{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "MultiWarden",
  "version": "1.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "de",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MultiWarden",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "idle",
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "content/fido2-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "content/fido2-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/autofill.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inline-menu.html",
        "inline-menu.js",
        "inline-menu.css",
        "notification.html",
        "notification.js",
        "notification.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_cmdOpen__"
    },
    "autofill_login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_cmdAutofillLogin__"
    },
    "autofill_card": {
      "description": "__MSG_cmdAutofillCard__"
    },
    "autofill_identity": {
      "description": "__MSG_cmdAutofillIdentity__"
    },
    "generate_password": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "__MSG_cmdGeneratePassword__"
    },
    "lock_all": {
      "description": "__MSG_cmdLock__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "optional_permissions": [
    "privacy"
  ]
}
